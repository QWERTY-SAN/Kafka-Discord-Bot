# Discord
DISCORD_TOKEN=your_discord_bot_token

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Bot
BOT_PREFIX=k!

# Conversation
MAX_HISTORY=16
MEMORY_TTL_SECONDS=21600
MAX_CONVERSATIONS=500
MAX_INPUT_CHARS=6000

# Generation
MAX_OUTPUT_TOKENS=1536
THINKING_LEVEL=medium

# Reliability
USER_COOLDOWN=2.0
MAX_CONCURRENT_REQUESTS=3
REQUEST_TIMEOUT=45
MAX_RETRIES=3

# Kafka presentation
EMOJIS_ENABLED=true
KAFKA_GIF_ENABLED=true
KAFKA_GIF_MODE=every_mention
# Modes: off, first_reply, every_mention, every_command, every_response
# The bot downloads the GIF and uploads it to Discord so it does not depend on Discord embedding the remote URL.
KAFKA_GIF_COOLDOWN_SECONDS=300
KAFKA_GIF_URL=https://www.gifcen.com/wp-content/uploads/2023/08/kafka-gif-6.gif

# Render Web Service
PORT=10000
